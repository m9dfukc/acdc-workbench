+/* LED modes CLIP and OFF: the LEDs are switched off once and then left alone,
+ * so that no pin or timer register is written while nothing changes. In CLIP
+ * mode an input LED turns red (the static pin only, no PWM) for 300 ms after a
+ * raw input sample reached -0.1 dBFS while the host records.
+ *
+ * Memory layout: this function and the larger onLoop() live in .text.onLoop,
+ * which is in ITCM like .late_text, and take their space from the padding
+ * below. acdcOnLoopLate() is unchanged, so every other function in ITCM keeps
+ * the address it has without the LED mode. */
+__attribute__((noinline, optimize("Os"), section(".text.onLoop")))
+static void acdcOnLoopDark(uint8_t mode){
+  extern float tx_levels[4];
+  for(size_t i=0; i<4; ++i)
+    setParameterValue(PARAMETER_BA+i, tx_levels[i]*4096);
+  const bool raw = mode == ACDC_LEDS_CLIP && usbd_tx != NULL;
+  if(!acdc_boot.led_dark || acdc_raw.magic != ACDC_RAW_MAGIC || (raw && !acdc_raw.was_raw)){
+    memset(&acdc_raw, 0, sizeof(acdc_raw));
+    acdc_raw.magic = ACDC_RAW_MAGIC;
+    for(size_t i=1; i<=8; ++i)
+      setLed(i, NO_COLOUR);
+    acdc_boot.led_dark = 1;
+  }
+  if(mode != ACDC_LEDS_CLIP)
+    return;
+  const uint8_t clip = raw ? acdcMeasureRawInputs() : 0;
+  acdc_raw.was_raw = raw;
+  const uint32_t now = HAL_GetTick();
+  for(size_t i=0; i<4; ++i){
+    if(clip & (1<<i)){
+      acdc_raw.clip_tick[i] = now;
+      if(!acdc_raw.clip_hold[i]){
+        acdc_raw.clip_hold[i] = 1;
+        setLed(i+1, RED_COLOUR);
+      }
+    }else if(acdc_raw.clip_hold[i] && (!raw || now - acdc_raw.clip_tick[i] >= ACDC_RAW_CLIP_HOLD_MS)){
+      acdc_raw.clip_hold[i] = 0;
+      setLed(i+1, NO_COLOUR);
+    }
+  }
 }
 
