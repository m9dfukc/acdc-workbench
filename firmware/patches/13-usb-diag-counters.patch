+/* AC/DC fork, Patch 13 (diagnostic build, acdc project docs/05 "Build 5"):
+   counters for the USB audio path, reported by onLoop (ACDC.cpp) as program message.
+   Not for release builds. */
+#ifndef __ACDC_USB_DIAG_H
+#define __ACDC_USB_DIAG_H
+#include <stdint.h>
+struct AcdcUsbDiag {
+  uint32_t out_lost;     /* l: missing frame numbers between ISO OUT packets (sum of gap-1) */
+  uint32_t out_gaps;     /* g: number of such gaps */
+  uint32_t out_dup;      /* k: two ISO OUT packets with the same frame number */
+  uint32_t out_late;     /* L: frame number changed between DataOut entry and re-arm */
+  uint32_t out_badlen;   /* b: packet length outside 47..49 frames */
+  uint32_t out_incomp;   /* i: INCOMPISOOUT interrupts */
+  uint32_t in_tx_incomp; /* t: ISO IN incomplete, audio TX endpoint */
+  uint32_t in_fb_incomp; /* f: ISO IN incomplete, feedback endpoint */
+  uint32_t fb_clamp;     /* c: feedback controller at its limit (replaces message "fb clamp") */
+  uint32_t fb_disc;      /* d: feedback measurement discarded (replaces message "fb") */
+  uint32_t err;          /* e: usbd_audio_error calls (rx ovf/unf, tx ovf/unf) */
+  uint32_t sof_lost;     /* s: missing SOF frame numbers */
+  uint32_t pos_min;      /* p: CPU cycles from SOF interrupt to DataOut, min and max */
+  uint32_t pos_max;
+  uint32_t sof_cyc;
+  uint16_t last_out_fn;
+  uint16_t last_sof_fn;
+  uint8_t out_valid;
+  uint8_t sof_valid;
+  uint8_t active;
+};
+#ifdef __cplusplus
+extern "C" AcdcUsbDiag acdc_usb_diag;
+#endif
+#endif
