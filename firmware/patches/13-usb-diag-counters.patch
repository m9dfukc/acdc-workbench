+/* AC/DC fork, Patch 13: diagnostic counters (acdc_usb_diag.h). The helpers are
+   always inlined, so they stay in the USB functions (and move with them into ITCM). */
+AcdcUsbDiag acdc_usb_diag;
+static inline __attribute__((always_inline)) uint16_t acdc_diag_fn(void){
+  return (uint16_t)USB_SOF_NUMBER();
+}
+static inline __attribute__((always_inline)) void acdc_diag_sof(void){
+  AcdcUsbDiag& d = acdc_usb_diag;
+  if(!(DWT->CTRL & DWT_CTRL_CYCCNTENA_Msk)){
+    CoreDebug->DEMCR |= CoreDebug_DEMCR_TRCENA_Msk;
+    DWT->LAR = 0xC5ACCE55;
+    DWT->CYCCNT = 0;
+    DWT->CTRL |= DWT_CTRL_CYCCNTENA_Msk;
+  }
+  d.sof_cyc = DWT->CYCCNT;
+  uint16_t fn = acdc_diag_fn();
+  if(d.sof_valid){
+    uint16_t gap = (fn - d.last_sof_fn) & 0x7ff;
+    if(gap > 1)
+      d.sof_lost += gap - 1;
+  }
+  d.last_sof_fn = fn;
+  d.sof_valid = 1;
+}
+static inline __attribute__((always_inline)) uint16_t acdc_diag_out_enter(bool first){
+  AcdcUsbDiag& d = acdc_usb_diag;
+  uint32_t pos = DWT->CYCCNT - d.sof_cyc;
+  uint16_t fn = acdc_diag_fn();
+  if(first){
+    uint8_t sof_valid = d.sof_valid;
+    uint16_t last_sof_fn = d.last_sof_fn;
+    uint32_t sof_cyc = d.sof_cyc;
+    memset(&d, 0, sizeof(d));
+    d.sof_valid = sof_valid;
+    d.last_sof_fn = last_sof_fn;
+    d.sof_cyc = sof_cyc;
+    d.pos_min = 0xffffffff;
+    d.active = 1;
+  }else if(d.out_valid){
+    uint16_t gap = (fn - d.last_out_fn) & 0x7ff;
+    if(gap == 0){
+      d.out_dup++;
+    }else if(gap > 1){
+      d.out_gaps++;
+      d.out_lost += gap - 1;
+    }
+  }
+  if(pos < d.pos_min) d.pos_min = pos;
+  if(pos > d.pos_max) d.pos_max = pos;
+  d.last_out_fn = fn;
+  d.out_valid = 1;
+  return fn;
+}
 
