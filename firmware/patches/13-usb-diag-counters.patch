+/* AC/DC fork, Patch 13 (diagnostic build): USB counters as program message every
+   500 ms while a USB audio stream has been seen, see Source/acdc_usb_diag.h.
+   "l g k L b i t f c d e s p<min>-<max>" (p in us after the SOF interrupt). */
+#include "acdc_usb_diag.h"
+extern "C" uint32_t SystemCoreClock;
+static char acdc_diag_msg[64];
+__attribute__((noinline, section(".late_text")))
+static char* acdcDiagPut(char* p, char* end, const char* tag, uint32_t v){
+  char t[10];
+  int n = 0;
+  do{ t[n++] = '0' + v % 10; v /= 10; }while(v && n < 10);
+  while(*tag && p < end) *p++ = *tag++;
+  while(n && p < end) *p++ = t[--n];
+  return p;
+}
+__attribute__((noinline, section(".late_text")))
+static void acdcUsbDiagReport(uint32_t now){
+  static uint32_t last = 0;
+  const AcdcUsbDiag& d = acdc_usb_diag;
+  if(!d.active || now - last < 500)
+    return;
+  last = now;
+  const uint32_t mhz = SystemCoreClock / 1000000;
+  char* p = acdc_diag_msg;
+  char* end = acdc_diag_msg + sizeof(acdc_diag_msg) - 1;
+  p = acdcDiagPut(p, end, "l", d.out_lost);
+  p = acdcDiagPut(p, end, " g", d.out_gaps);
+  p = acdcDiagPut(p, end, " k", d.out_dup);
+  p = acdcDiagPut(p, end, " L", d.out_late);
+  p = acdcDiagPut(p, end, " b", d.out_badlen);
+  p = acdcDiagPut(p, end, " i", d.out_incomp);
+  p = acdcDiagPut(p, end, " t", d.in_tx_incomp);
+  p = acdcDiagPut(p, end, " f", d.in_fb_incomp);
+  p = acdcDiagPut(p, end, " c", d.fb_clamp);
+  p = acdcDiagPut(p, end, " d", d.fb_disc);
+  p = acdcDiagPut(p, end, " e", d.err);
+  p = acdcDiagPut(p, end, " s", d.sof_lost);
+  p = acdcDiagPut(p, end, " p", d.pos_min == 0xffffffff ? 0 : d.pos_min / mhz);
+  p = acdcDiagPut(p, end, "-", d.pos_max / mhz);
+  *p = 0;
+  getProgramVector()->message = acdc_diag_msg;
 }
 
